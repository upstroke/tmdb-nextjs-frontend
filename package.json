{
  "name": "tmdb-nextjs-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project browser vitest/component",
    "test:integration": "vitest run --project integration vitest/integration",
    "test:browser": "vitest run --project browser",
    "test:e2e": "cypress run --e2e --browser chrome",
    "test:e2e:open": "cypress open --e2e --browser chrome",
    "test:e2e:security": "cypress run --e2e --browser chrome --spec \"cypress/e2e/security/**/*.cy.js\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fomantic-ui-css": "^2.9.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cypress/webpack-preprocessor": "^6.0.4",
    "@testing-library/cypress": "^10.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.3.3",
    "jsdom": "^30.1.2",
    "next": "^16.3.8",
    "playwright": "^1.63.0",
    "postcss": "^8.5.29",
    "prettier": "^3.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.21",
    "vite-plugin-istanbul": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
