{
  "name": "tmdb-nextjs-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project browser vitest/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run --e2e --browser chrome",
    "test:e2e:open": "cypress open --e2e --browser chrome",
    "test:e2e:security": "cypress run --e2e --browser chrome --spec 'cypress/e2e/security/**/*.cy.js'",
    "test:e2e:a11y": "cypress run --e2e --browser chrome --spec 'cypress/accessibility/**/*.cy.js'",
    "validate": "npm run validate:fast && npm run validate:full",
    "validate:fast": "npm run lint && npm run format:check && npm run test:unit",
    "validate:full": "npm run test:component && npm run test:integration && npm run test:coverage",
    "validate:e2e": "npm run build && npm run test:e2e",
    "validate:a11y": "npm run build && npm run test:e2e:a11y",
    "check": "npm run lint && npm run format:check && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "fomantic-ui-css": "^2.9.3",
    "next": "16.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "3.2.4",
    "cypress": "^15.5.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.6",
    "prettier": "3.6.2",
    "sass": "^1.94.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,scss,css,md,json}": [
      "prettier --write"
    ]
  }
}
