{
  "name": "tmdb-nextjs-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:component": "cypress run --component",
    "test:e2e": "cypress run --config-file tests/cypress.config.js --browser chrome",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/vitest/security/ && cypress run --component --spec 'tests/cypress/acceptance/components/security/**/*'",
    "test:security:unit": "vitest run tests/vitest/security/",
    "test:security:component": "cypress run --component --spec 'tests/cypress/acceptance/components/security/**/*'"
  },
  "dependencies": {
    "fomantic-ui-css": "^2.9.4",
    "next": "15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cypress/webpack-preprocessor": "^6.0.4",
    "@testing-library/cypress": "^10.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.10.3",
    "cypress": "^13.17.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.3.3",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "postcss": "^8.5.29",
    "prettier": "^3.5.3",
    "sass": "^1.105.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
