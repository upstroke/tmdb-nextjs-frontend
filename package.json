{
  "name": "tmdb-nextjs-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:component": "cypress run --component",
    "test:e2e": "cypress run --e2e",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/vitest/security/ && cypress run --component --spec 'tests/cypress/acceptance/components/security/**/*'",
    "test:security:unit": "vitest run tests/vitest/security/",
    "test:security:component": "cypress run --component --spec 'tests/cypress/acceptance/components/security/**/*'"
  },
  "dependencies": {
    "next": "14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.2.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@vitejs/plugin-react": "^4.2.0",
    "cypress": "^13.0.0",
    "vitest": "^1.0.0",
    "@types/react": "^18.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}