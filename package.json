{
  "name": "tmdb-nextjs-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --project unit --project integration && node scripts/coverage-filter.js",
    "test:browser": "vitest run --project browser",
    "coverage:filter": "node scripts/coverage-filter.js"
  },
  "dependencies": {
    "next": "15.3.3",
    "next-intl": "^4.1.0",
    "playwright": "^1.53.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^3.2.7",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "typescript": "^5.8.3"
  }
}
